# NestJS
JWT_SECRET=secret
JWT_EXPIRATION=5m
JWT_REFRESH_EXPIRATION=30d
EMAIL_VERIFICATION_TOKEN_EXPIRATION=24h
PASSWORD_RESET_TOKEN_EXPIRATION=1h
COMMENT_SOFT_DELETE_RETENTION=30d
REPLY_SOFT_DELETE_RETENTION=30d
CSRF_SECRET=your-csrf-secret-key-change-in-production
MAIL_FROM=noreply@worldoftoilets.com
FRONTEND_URL=http://nginx
MINIO_ENDPOINT=minio
MINIO_USE_SSL=false
MINIO_BUCKET=wot
MINIO_PUBLIC_URL=http://nginx/files
AI_SERVICE_TIMEOUT=30000
CORS_ORIGINS=http://nginx
COOKIE_SECURE=true

# NextJS
NEXT_PUBLIC_API_URL=http://nginx/api

# Minio
MINIO_ROOT_USER=minio_user
MINIO_ROOT_PASSWORD=minio_password

# Python/Flask AI Service - Route Calculator
AI_WORKERS=1
AI_SERVICE_AREA=Lisboa, Portugal
AI_NETWORK_TYPE=walk
AI_WALKING_SPEED_MPS=1.3
AI_SIMPLIFY_GRAPH=True
AI_LOG_LEVEL=INFO
AI_REQUEST_TIMEOUT=120
AI_GRAPH_LOAD_TIMEOUT=300
