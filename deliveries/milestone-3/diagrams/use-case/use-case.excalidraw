      "versionNonce": 1389962826,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1765389487271,
      "link": null,
      "locked": false,
      "text": "O aplicativo exibe no mapa os resultados encontrados,\nincluindo nome, distância e acessibilidade por carro.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O aplicativo exibe no mapa os resultados encontrados, incluindo nome, distância e acessibilidade por carro.",
