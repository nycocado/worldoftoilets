      "isDeleted": true,
      "boundElements": [],
      "updated": 1765389487271,
      "link": null,
      "locked": false,
      "text": "O motorista seleciona uma das opções de casa de banho.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O motorista seleciona uma das opções de casa de banho.",
