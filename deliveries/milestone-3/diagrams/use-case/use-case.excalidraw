      "isDeleted": true,
      "boundElements": [],
      "updated": 1765389487271,
      "link": null,
      "locked": false,
      "text": "O sistema traça e exibe a rota ideal para carro até o\nlocal selecionado, com tempo estimado de chegada.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O sistema traça e exibe a rota ideal para carro até o local selecionado, com tempo estimado de chegada.",
