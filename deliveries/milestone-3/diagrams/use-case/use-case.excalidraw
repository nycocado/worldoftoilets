      "isDeleted": true,
      "boundElements": [],
      "updated": 1765389487271,
      "link": null,
      "locked": false,
      "text": "O sistema pesquisa casas de banho disponíveis dentro de\num raio de até 800 metros.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "O sistema pesquisa casas de banho disponíveis dentro de um raio de até 800 metros.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
